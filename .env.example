# 複製這個檔案為 .env，填入實際值。.env 不會進版控。

# ── 資料庫 ─────────────────────────────────────────────
# 本地開發：docker compose up -d 之後就是這個位址（外部埠 5433，避免和既有 Postgres 衝突）
DATABASE_URL="postgres://dogking:dogking@localhost:5433/dogking"

# ── Discord OAuth ──────────────────────────────────────
# 取得方式見 README「設定 Discord 應用程式」
# 權限只要 identify，不要勾 email
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:5173/auth/callback"

# ── 活動設定 ───────────────────────────────────────────
# 註冊贈送的狗狗幣
SIGNUP_BONUS="1000"
